map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;

    ssl_certificate /etc/letsencrypt/live/${PUBLIC_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Re-resolve service names through Docker's DNS instead of pinning the IPs nginx saw
    # at boot — a deploy recreates services on new IPs. See gateway/nginx.conf.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $auth     http://auth:8000;
    set $domain   http://domain:8000;
    set $agent    http://agent:8000;
    set $frontend http://frontend:80;

    location /api/auth/ {
        rewrite ^/api/auth/(.*)$ /$1 break;
        proxy_pass $auth;
        include /etc/nginx/proxy_common.conf;
    }

    location /api/domain/ {
        rewrite ^/api/domain/(.*)$ /$1 break;
        proxy_pass $domain;
        include /etc/nginx/proxy_common.conf;
    }

    location /api/agent/ {
        rewrite ^/api/agent/(.*)$ /$1 break;
        proxy_pass $agent;
        include /etc/nginx/proxy_common.conf;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }

    location / {
        proxy_pass $frontend;
        include /etc/nginx/proxy_common.conf;
    }
}
