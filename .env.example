# Copy to .env and fill in. NEVER commit .env.

# Postgres (defaults are fine for local dev)
POSTGRES_USER=maya
POSTGRES_PASSWORD=maya_dev_pw
POSTGRES_DB=voiceagent
DATABASE_URL=postgresql+psycopg://maya:maya_dev_pw@postgres:5432/voiceagent

# Auth
JWT_SECRET=change-me-long-random
ADMIN_EMAIL=admin@assortderm.com
ADMIN_PASSWORD=change-me

# AI / voice providers
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_LLM_API_KEY=
PUBLIC_HOST=
LETSENCRYPT_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# LangFuse Cloud
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Jira (used by scripts/push_jira_backlog.py)
JIRA_API_TOKEN=
JIRA_EMAIL=
JIRA_SITE_URL=
